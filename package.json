{
  "name": "arm-browser",
  "version": "1.1.0",
  "description": "arm Browser - プロキシなし・本物のChromiumエンジンで動作するLinuxデスクトップブラウザ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux",
    "build:appimage": "electron-builder --linux AppImage",
    "build:deb": "electron-builder --linux deb",
    "build:rpm": "electron-builder --linux rpm"
  },
  "author": "arm Browser",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.armbrowser.app",
    "productName": "arm Browser",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "icon.png",
      "maintainer": "arm Browser <arm@example.com>"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ]
  }
}